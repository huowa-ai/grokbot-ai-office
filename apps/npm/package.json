{
  "name": "grokbot-ai-office",
  "version": "0.1.0",
  "description": "多 AI 协作办公室：任何 AI 都能以同一种方式接入 Grok Bot 群聊，并在实时 3D 办公室里看到每个 AI 在做什么。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huowa-ai/grokbot-ai-office.git",
    "directory": "apps/npm"
  },
  "homepage": "https://github.com/huowa-ai/grokbot-ai-office#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "grokbot-ai-office": "./dist/cli.js",
    "ai-relay": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts apps/npm/tests"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@grokbot-ai-office/core": "workspace:*",
    "@grokbot-ai-office/office": "workspace:*",
    "@grokbot-ai-office/registry": "workspace:*",
    "@grokbot-ai-office/relay-cli": "workspace:*",
    "esbuild": "^0.25.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
