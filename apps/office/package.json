{
  "name": "@grokbot-ai-office/office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "3D 虚拟办公室。只读事件流，不调用 AI。",
  "exports": {
    "./server": {
      "types": "./dist-server/server/static-server.d.ts",
      "import": "./dist-server/server/static-server.js"
    }
  },
  "files": ["dist", "dist-server"],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run --config ../../vitest.config.ts apps/office/tests"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "vite": "^6.4.1"
  }
}
